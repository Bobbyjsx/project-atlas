# Local Development URLs
KEYSENTRY_URL="http://localhost:8001"
CHESS_URL="http://localhost:8002"

# ----------------------------------------------------------------------
# Local Deployment Simulation / CI Variables
# Used by envsubst to populate cloudrun-service.yaml
# ----------------------------------------------------------------------
GCP_PROJECT_ID="project-atlas-501612"
ATLAS_VERSION="latest"
KEYSENTRY_VERSION="v2.4.2"
COGNITO_VERSION="latest"

ATLAS_SECRET="atlas-gateway-secrets"
KEYSENTRY_SECRET="keysentry-api-secrets"
COGNITO_SECRET="cognito-api-secrets"

# ----------------------------------------------------------------------
# Google Secret Manager Secrets (GSM)
# Add these exact JSON payloads to Google Secret Manager in Production
# ----------------------------------------------------------------------
#
# Name in GSM: atlas-gateway-secrets
# Payload (JSON):
# {
#   "API_KEY_KEYSENTRY": "...",
#   "API_KEY_CHESS": "...",
#   "API_KEY_COGNITO": "..."
# }
#
# Name in GSM: keysentry-api-secrets
# Payload (JSON):
# {
#   "DATABASE_URL": "postgresql+asyncpg://user:password@cloud-sql-proxy:5432/db",
#   "GOTRUE_JWT_SECRET": "your-gotrue-jwt-secret-here",
#   "GOTRUE_URL": "https://keysentry-auth.bobslab.xyz",
#   "ENCRYPTION_KEY": "your-encryption-key",
#   "TRIGGER_API_KEY": "tr_dummy_key_123",
#   "INTERNAL_API_SECRET": "your-internal-api-secret"
# }
#
# Name in GSM: cognito-api-secrets
# Payload (JSON):
# {
#   "GEMINI_API_KEY": "...",
#   "APP_NAME": "...",
#   "SECRET_KEY": "...",
#   "FIRESTORE_DATABASE": "...",
#   "STORAGE_BACKEND": "...",
#   "STORAGE_BUCKET": "...",
#   "REDIS_URL": "rediss://default:YOUR_TOKEN_HERE@your-upstash-url.upstash.io:6379"
# }
